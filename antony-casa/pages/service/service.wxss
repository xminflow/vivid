/* service.wxss 服务列表：一服务一图，字压在照片上 */

/* 页内不再有大标题，标题只在导航栏。第一张卡片直接顶上来 */
.page {
  min-height: 100vh;
  padding-top: 48rpx;
  padding-bottom: 60rpx;
  background: var(--sfondo);
}

/* ---------- 服务卡 ---------- */

.item {
  margin: 0 40rpx 28rpx;
  background: var(--bianco);
  border-radius: var(--radius);
  /* 图片的上圆角靠这层裁，图片自己不用再设 */
  overflow: hidden;
}

.item-hover {
  opacity: 0.72;
}

/* ---------- 照片 ---------- */

.shot {
  position: relative;
  height: 360rpx;
}

/* 没有实拍时的卡头：墨底 + 一个压在右侧的巨大序号。
   比照片矮一档——没有画面要看，留那么高就是空 */
.shot-plain {
  height: 240rpx;
  overflow: hidden;
  background: var(--nero);
}

/* 序号做底纹，压到右下角，一半切出画外 */
.ghost {
  position: absolute;
  right: -18rpx;
  bottom: -56rpx;
  font-size: 220rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.04em;
  color: rgba(255, 255, 255, 0.08);
}

.shot-image {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--sfondo);
}

/* 照片有亮有暗，压一道渐变，压在上面的白字才始终读得出来 */
.shot-veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(0deg, rgba(17, 17, 17, 0.72) 0%, rgba(17, 17, 17, 0.32) 46%, rgba(17, 17, 17, 0) 100%);
  pointer-events: none;
}

.shot-title {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
}

.shot-ordinal {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.16em;
  color: var(--su-foto-debole);
}

.shot-name {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: var(--ls-display);
  color: var(--su-foto);
}

/* ---------- 说明 ---------- */

.body {
  padding: 28rpx 32rpx 26rpx;
}

.tagline {
  display: block;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: var(--ls-meta);
  color: var(--nero);
}

/* 整段介绍在申请页，这里只露两行，卡片才不会被大段文字压住 */
.intro {
  display: -webkit-box;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.75;
  letter-spacing: var(--ls-meta);
  color: var(--grigio);
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--hairline);
}

/* 没有注意事项时这里是空串，仍占位，「立即申请」才不会跳到左边 */
.note {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
  font-size: 21rpx;
  line-height: 1.6;
  letter-spacing: var(--ls-meta);
  color: var(--grigio-chiaro);
}

.cta {
  flex: none;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--nero);
}

/* ---------- 客服 ---------- */

.tail {
  padding: 20rpx 40rpx 0;
}

.contact {
  display: block;
  text-align: center;
}

.contact-text {
  font-size: 25rpx;
  line-height: 1.6;
  letter-spacing: var(--ls-meta);
  color: var(--grigio);
  text-decoration: underline;
}
