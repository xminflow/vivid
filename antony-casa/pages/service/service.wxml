<!--service.wxml 五个服务，每个可单独申请-->
<view class="page">

  <!-- 一服务一张图。序号和服务名压在照片上，说明落在下面的白底里；
       介绍原文很长，这里只露三行，整段在申请页 -->
  <view
    class="item"
    wx:for="{{services}}"
    wx:key="id"
    hover-class="item-hover"
    hover-stay-time="120"
    data-id="{{item.id}}"
    bindtap="onApply"
  >
    <!-- 有实拍走照片版，没有就走深色版：两版共用同一套标题排布，
         mock 里把 image 填回去即可切换，页面不用改 -->
    <view class="shot" wx:if="{{item.image}}">
      <image class="shot-image" src="{{item.image}}" mode="aspectFill" lazy-load />
      <view class="shot-veil"></view>
      <view class="shot-title">
        <text class="shot-ordinal">{{item.ordinal}}</text>
        <text class="shot-name">{{item.name}}</text>
      </view>
    </view>

    <view class="shot shot-plain" wx:else>
      <text class="ghost">{{item.ordinal}}</text>
      <view class="shot-title">
        <text class="shot-ordinal">{{item.ordinal}}</text>
        <text class="shot-name">{{item.name}}</text>
      </view>
    </view>

    <view class="body">
      <text class="tagline">{{item.tagline}}</text>
      <text class="intro">{{item.intro}}</text>

      <view class="foot">
        <text class="note">{{item.note ? '注 · ' + item.note : ''}}</text>
        <text class="cta">立即申请 ›</text>
      </view>
    </view>
  </view>

  <view class="tail">
    <button class="contact" open-type="contact" hover-class="none">
      <text class="contact-text">拿不准选哪项？在线咨询客服</text>
    </button>
  </view>

</view>
