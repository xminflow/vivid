<!--address-edit.wxml 新增 / 编辑收货地址-->
<view class="page">

  <view class="card">

    <view class="field">
      <text class="label">收货人</text>
      <input
        class="input"
        value="{{receiver}}"
        data-field="receiver"
        placeholder="请填写收货人姓名"
        placeholder-class="ph"
        maxlength="20"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <!-- 空态是个 button（点它弹微信授权），有值之后换成 input 直接改。
           这里用 wx:if 而不是 hidden：自定义组件对 hidden 不生效，节点仍占位、
           占位文案还露在外面。摘掉 phone-get 是安全的——切换只发生在授权回调
           已经处理完之后（成功写值、或失败转手输），不会把还等着回调的组件销毁。
           也不能反过来做成「input 上盖一层」：input 是原生组件，盖不住，见 phone-get -->
      <input
        wx:if="{{phone || phoneManual}}"
        class="input"
        value="{{phone}}"
        data-field="phone"
        type="number"
        placeholder="请填写手机号"
        placeholder-class="ph"
        maxlength="11"
        focus="{{phoneFocus}}"
        bindinput="onInput"
      />
      <phone-get
        wx:else
        placeholder="请填写手机号"
        bind:got="onWxPhone"
        bind:manual="onPhoneManual"
      />
    </view>

    <!-- 省市区三级联动由微信自带，不在包里塞行政区划表 -->
    <picker mode="region" value="{{region}}" bindchange="onRegion">
      <view class="field">
        <text class="label">所在地区</text>
        <text class="input {{regionText ? '' : 'ph'}}">{{regionText || '请选择省 / 市 / 区'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>

    <view class="field field-area">
      <text class="label">详细地址</text>
      <textarea
        class="textarea"
        value="{{detail}}"
        data-field="detail"
        placeholder="街道、门牌号、楼层"
        placeholder-class="ph"
        maxlength="100"
        auto-height
        bindinput="onInput"
      />
    </view>

  </view>

  <view class="card">
    <view class="field field-switch">
      <text class="label">设为默认地址</text>
      <switch
        checked="{{isDefault}}"
        disabled="{{lockDefault}}"
        color="#111111"
        bindchange="onDefault"
      />
    </view>
    <!-- 已是默认时开关锁死：关掉会让这个人一个默认地址都没有 -->
    <text class="hint" wx:if="{{lockDefault}}">这是当前的默认地址。要换到别的地址，去列表里点「设为默认」</text>
  </view>

  <view class="bar">
    <view class="save {{submitting ? 'save-off' : ''}}" bindtap="onSubmit" hover-class="save-hover">
      <text class="save-text">{{submitting ? '保存中…' : '保存'}}</text>
    </view>
  </view>

</view>
