/* address.wxss 地址簿：白卡列表 + 底部固定新增按钮 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--sfondo);
}

/* ---------- 空态 / 加载态 ---------- */

.state {
  padding: 200rpx 40rpx;
  text-align: center;
}

.state-text {
  display: block;
  font-size: 28rpx;
  color: var(--grigio-chiaro);
}

/* ---------- 列表 ---------- */

.list {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  background: var(--bianco);
  border-radius: var(--radius);
  overflow: hidden;
}

.main {
  padding: 32rpx;
}

.main-hover {
  background: rgba(17, 17, 17, 0.03);
}

.head {
  display: flex;
  align-items: center;
}

.receiver {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--nero);
}

.phone {
  margin-left: 20rpx;
  font-size: 26rpx;
  letter-spacing: var(--ls-meta);
  color: var(--grigio);
}

.tag {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  letter-spacing: var(--ls-meta);
  color: var(--su-foto);
  background: var(--nero);
  border-radius: 4rpx;
}

.detail {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--grigio);
}

/* ---------- 每张卡底部的操作 ---------- */

.ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 32rpx 24rpx;
  border-top: 1rpx solid var(--hairline);
  padding-top: 20rpx;
}

.op {
  margin-left: 32rpx;
}

.op-text {
  font-size: 24rpx;
  letter-spacing: var(--ls-meta);
  color: var(--grigio);
}

.list-tail {
  height: 180rpx;
}

/* ---------- 底部固定按钮 ---------- */

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bianco);
  border-top: 1rpx solid var(--hairline);
}

.add {
  padding: 24rpx 0;
  text-align: center;
  background: var(--nero);
  border-radius: 999rpx;
}

.add-hover {
  opacity: 0.72;
}

.add-text {
  font-size: 28rpx;
  letter-spacing: var(--ls-meta);
  color: var(--su-foto);
}
