/* checkout.wxss 结算：白卡分组 + 底部固定提交条 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--sfondo);
}

.state {
  padding: 200rpx 40rpx;
  text-align: center;
}

.state-text {
  display: block;
  font-size: 28rpx;
  color: var(--grigio-chiaro);
}

.body {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: var(--bianco);
  border-radius: var(--radius);
}

/* ---------- 收货地址 ---------- */

.addr {
  padding-right: 56rpx;
}

.addr-hover {
  background: rgba(17, 17, 17, 0.03);
}

.addr-head {
  display: flex;
  align-items: center;
}

.addr-receiver {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--nero);
}

.addr-phone {
  margin-left: 20rpx;
  font-size: 26rpx;
  letter-spacing: var(--ls-meta);
  color: var(--grigio);
}

.addr-detail {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--grigio);
}

.addr-empty {
  font-size: 28rpx;
  color: var(--grigio-chiaro);
}

.arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: var(--grigio-chiaro);
}

/* ---------- 订单行 ---------- */

.row {
  display: flex;
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.row:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  flex: none;
  border-radius: 8rpx;
  background: var(--sfondo);
}

.cover-empty {
  background: var(--sfondo);
}

.row-body {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.row-title {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--nero);
}

.row-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.row-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--nero);
}

.row-qty {
  font-size: 26rpx;
  color: var(--grigio);
}

.tail {
  height: 200rpx;
}

/* ---------- 底部提交条 ---------- */

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bianco);
  border-top: 1rpx solid var(--hairline);
}

.bar-sum {
  flex: 1;
}

.bar-total {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--nero);
}

.submit {
  padding: 22rpx 56rpx;
  background: var(--nero);
  border-radius: 999rpx;
}

.submit-hover {
  opacity: 0.72;
}

.submit-off {
  opacity: 0.4;
}

.submit-text {
  font-size: 28rpx;
  letter-spacing: var(--ls-meta);
  color: var(--su-foto);
}
