<!--booking.wxml 预约参观登记-->
<view class="page">

  <view class="hd">
    <text class="hd-title">预约参观</text>
    <text class="hd-en">Book a Visit</text>
    <text class="hd-sub">杭州展厅</text>
  </view>

  <view class="form">
    <view class="row">
      <text class="label">您的称呼</text>
      <input
        class="input"
        value="{{form.name}}"
        placeholder="怎么称呼您"
        placeholder-class="ph"
        maxlength="40"
        bindinput="onNameInput"
      />
    </view>

    <view class="row">
      <text class="label">您的电话</text>
      <!-- 空态是个 button（点它弹微信授权），有值之后换成 input 直接改。
           这里用 wx:if 而不是 hidden：自定义组件对 hidden 不生效，节点仍占位、
           占位文案还露在外面。摘掉 phone-get 是安全的——切换只发生在授权回调
           已经处理完之后（成功写值、或失败转手输），不会把还等着回调的组件销毁。
           也不能反过来做成「input 上盖一层」：input 是原生组件，盖不住，见 phone-get -->
      <input
        wx:if="{{form.phone || phoneManual}}"
        class="input"
        type="number"
        value="{{form.phone}}"
        placeholder="11 位手机号"
        placeholder-class="ph"
        maxlength="11"
        focus="{{phoneFocus}}"
        bindinput="onPhoneInput"
      />
      <phone-get
        wx:else
        placeholder="11 位手机号"
        bind:got="onWxPhone"
        bind:manual="onPhoneManual"
      />
    </view>

    <picker
      class="row-picker"
      range="{{visitorTypes}}"
      value="{{form.visitorTypeIndex}}"
      bindchange="onVisitorTypeChange"
    >
      <view class="picker-row">
        <text class="label">来者身份</text>
        <!-- text 内部的换行和缩进会原样渲染，内容必须贴着标签写成一行 -->
        <text class="value {{form.visitorTypeIndex < 0 ? 'value-empty' : ''}}">{{form.visitorTypeIndex < 0 ? '请选择' : visitorTypes[form.visitorTypeIndex]}}</text>
        <text class="chevron">›</text>
      </view>
    </picker>

    <picker
      class="row-picker"
      mode="date"
      start="{{today}}"
      value="{{form.visitDate}}"
      bindchange="onDateChange"
    >
      <view class="picker-row">
        <text class="label">到访日期</text>
        <text class="value {{form.visitDate ? '' : 'value-empty'}}">{{form.visitDate ? form.visitDate : '请选择'}}</text>
        <text class="chevron">›</text>
      </view>
    </picker>

    <!-- mode="time" 的选择器就是小时、分钟两列，start/end 卡在营业时段内，
         滚不到打烊之后的钟点。没选过时先把游标停在开门时间上，
         传空串它会从 00:00 起滚，那个点展厅没人 -->
    <picker
      class="row-picker"
      mode="time"
      start="{{openTime}}"
      end="{{closeTime}}"
      value="{{form.visitTime ? form.visitTime : openTime}}"
      bindchange="onTimeChange"
    >
      <view class="picker-row">
        <text class="label">到访时间</text>
        <text class="value {{form.visitTime ? '' : 'value-empty'}}">{{form.visitTime ? form.visitTime : '请选择'}}</text>
        <text class="chevron">›</text>
      </view>
    </picker>

    <view class="row">
      <text class="label">到访人数</text>
      <view class="stepper">
        <view
          class="step {{form.partySize <= 1 ? 'step-off' : ''}}"
          hover-class="step-hover"
          data-step="-1"
          bindtap="onPartyStep"
        >−</view>
        <text class="step-num">{{form.partySize}}</text>
        <view
          class="step {{form.partySize >= 50 ? 'step-off' : ''}}"
          hover-class="step-hover"
          data-step="1"
          bindtap="onPartyStep"
        >+</view>
      </view>
    </view>

    <picker
      class="row-picker"
      range="{{purposes}}"
      value="{{form.purposeIndex}}"
      bindchange="onPurposeChange"
    >
      <view class="picker-row">
        <text class="label">预约需求</text>
        <text class="value {{form.purposeIndex < 0 ? 'value-empty' : ''}}">{{form.purposeIndex < 0 ? '请选择' : purposes[form.purposeIndex]}}</text>
        <text class="chevron">›</text>
      </view>
    </picker>

    <view class="row row-note">
      <text class="label">备注（选填）</text>
      <textarea
        class="textarea"
        value="{{form.note}}"
        placeholder="想重点看哪间、有没有特别的需求"
        placeholder-class="ph-area"
        maxlength="500"
        auto-height
        bindinput="onNoteInput"
      />
    </view>
  </view>

  <view class="foot">
    <view
      class="submit {{submitting ? 'submit-off' : ''}}"
      hover-class="submit-hover"
      hover-stay-time="120"
      bindtap="onSubmit"
    >
      <text class="submit-text">{{submitting ? '提交中' : '提交预约'}}</text>
    </view>
    <text class="foot-note">提交后我们会电话与您确认到访安排</text>
  </view>

</view>
