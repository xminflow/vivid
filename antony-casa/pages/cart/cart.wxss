/* cart.wxss 购物车：白卡列表 + 底部固定结算条 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--sfondo);
}

/* ---------- 空态 / 加载态 ---------- */

.state {
  padding: 200rpx 40rpx;
  text-align: center;
}

.state-text {
  display: block;
  font-size: 28rpx;
  color: var(--grigio-chiaro);
}

.state-go {
  display: inline-block;
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background: var(--nero);
  border-radius: 999rpx;
}

.state-go-hover {
  opacity: 0.72;
}

.state-go-text {
  font-size: 26rpx;
  letter-spacing: var(--ls-meta);
  color: var(--su-foto);
}

/* ---------- 失效提示 ---------- */

.invalid-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  background: var(--bianco);
  border-bottom: 1rpx solid var(--hairline);
}

.invalid-text {
  font-size: 24rpx;
  color: var(--grigio);
}

.invalid-go {
  font-size: 24rpx;
  letter-spacing: var(--ls-meta);
  color: var(--nero);
}

/* ---------- 列表 ---------- */

/* min-height:0 让列表在 flex 里能自己滚，而不是把整页撑破 */
.list {
  flex: 1;
  min-height: 0;
}

.row {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  background: var(--bianco);
  border-radius: var(--radius);
}

/* 失效行整体压淡，但**不隐藏**：悄悄移除会让用户以为自己没加过 */
.row-off {
  opacity: 0.5;
}

.tick {
  flex-shrink: 0;
  padding-right: 20rpx;
}

.tick-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--grigio-chiaro);
  border-radius: 50%;
}

.tick-on {
  background: var(--nero);
  border-color: var(--nero);
}

.tick-sign {
  font-size: 24rpx;
  line-height: 1;
  color: var(--su-foto);
}

.cover {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.cover-empty {
  background: var(--sfondo);
}

.body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  height: 160rpx;
  padding-left: 20rpx;
}

.title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--nero);
}

.off-tag {
  margin-top: 8rpx;
  font-size: 22rpx;
  letter-spacing: var(--ls-meta);
  color: var(--grigio-chiaro);
}

.foot {
  display: flex;
  align-items: center;
  margin-top: auto;
}

.price {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: var(--ls-display);
  color: var(--nero);
}

/* ---------- 数量步进 ---------- */

.stepper {
  display: flex;
  align-items: center;
}

.step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--nero);
  border: 1rpx solid var(--hairline);
  border-radius: 8rpx;
}

/* 到边界了就压灰。事件那边也会拦，这里只是让用户先看出来 */
.step-off {
  color: var(--grigio-chiaro);
}

.step-num {
  min-width: 56rpx;
  font-size: 26rpx;
  text-align: center;
  color: var(--nero);
}

.remove {
  padding-left: 24rpx;
  font-size: 24rpx;
  color: var(--grigio-chiaro);
}

/* 底部结算条是 fixed 的，列表尾部留出等高空白，否则最后一行被压在下面 */
.list-tail {
  height: 140rpx;
}

/* ---------- 底部结算条 ---------- */

.bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  /* 全面屏底部的手势条区域，不加这个按钮会贴到屏幕最下沿 */
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bianco);
  border-top: 1rpx solid var(--hairline);
}

.bar-all {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.bar-all-text {
  padding-left: 12rpx;
  font-size: 26rpx;
  color: var(--nero);
}

.bar-sum {
  display: flex;
  flex-direction: column;
  flex: 1;
  align-items: flex-end;
  padding-right: 24rpx;
}

.bar-total {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: var(--ls-display);
  color: var(--nero);
}

.bar-count {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--grigio-chiaro);
}

.checkout {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 200rpx;
  height: 76rpx;
  padding: 0 32rpx;
  background: var(--nero);
  border-radius: 999rpx;
}

.checkout-hover {
  opacity: 0.72;
}

/* 一件都没勾时压灰。仍然可点——点了给一句「请先选择商品」，
   比一个完全没反应的按钮更容易理解 */
.checkout-off {
  background: var(--grigio-chiaro);
}

.checkout-text {
  font-size: 28rpx;
  letter-spacing: var(--ls-meta);
  color: var(--su-foto);
}
