<!--mine.wxml 我的：顶部身份 + 四段折叠，默认全收起-->
<view class="page">

  <!-- 顶部身份。点一下直接展开下面的「我的信息」去改 -->
  <view
    class="me"
    hover-class="me-hover"
    hover-stay-time="120"
    data-k="info"
    bindtap="onToggleSection"
  >
    <!-- 头像的圆全部由下面这两个普通节点画，button 只叠在最上面接点击。
         微信基础样式会给 button 带上 position: relative 和它自己的盒模型，
         把图放进 button 里的话，绝对定位的图认的是 button 而不是这层 wrap，
         真机上 button 的实际盒子一旦不是正方，图就偏出圆外——看着就是「头像变形了」。
         button 不参与视觉之后，它在真机上被渲染成什么样都影响不到这个圆 -->
    <view class="me-avatar-wrap">
      <!-- 首字圆一直垫在底下，头像图盖在上面且要等 bindload 成功才显形。
           缓存里可能是上次会话留下的临时路径或过期签名地址，真机加载失败会先
           画出系统裂图，binderror 是失败之后才来的，挡不住那一帧 -->
      <view class="me-avatar {{initial ? '' : 'me-avatar-empty'}}">
        <text class="me-initial">{{initial}}</text>
      </view>
      <image
        wx:if="{{profile.avatarUrl && !avatarBroken}}"
        class="me-avatar-img {{avatarReady ? 'me-avatar-img-on' : ''}}"
        src="{{profile.avatarUrl}}"
        mode="aspectFill"
        bindload="onAvatarLoad"
        binderror="onAvatarError"
      />
      <!-- open-type="chooseAvatar" 只有 button 能带：点一下由微信弹
           「使用微信头像 / 从相册选 / 拍照」。
           catchtap 拦住冒泡，否则点头像会连带把下面的「我的信息」展开 -->
      <button
        class="me-avatar-hit"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
        catchtap="noop"
        hover-class="me-avatar-hit-hover"
        hover-stay-time="120"
      />
    </view>

    <view class="me-text">
      <text class="me-name {{profile.memberName ? '' : 'me-name-empty'}}">{{profile.memberName ? profile.memberName : '设置您的称呼'}}</text>
      <text class="me-sub">{{phoneMasked ? phoneMasked + ' · ' : ''}}{{brand.wordmark}} 会员</text>
    </view>
  </view>

  <!-- ========== 我的信息 ========== -->
  <view class="sec">
    <view
      class="sec-head"
      hover-class="sec-head-hover"
      hover-stay-time="120"
      data-k="info"
      bindtap="onToggleSection"
    >
      <text class="sec-title">我的信息</text>
      <text class="sec-mark {{open.info ? 'sec-mark-on' : ''}}">›</text>
    </view>

    <view class="sec-body" wx:if="{{open.info}}">
      <view class="card">
        <view class="row">
          <text class="label">会员名</text>
          <input
            class="input"
            value="{{profile.memberName}}"
            placeholder="怎么称呼您"
            placeholder-class="ph"
            maxlength="40"
            bindinput="onMemberNameInput"
          />
        </view>

        <view class="row">
          <text class="label">手机号码</text>
          <!-- 空态是个 button（点它弹微信授权），有值之后换成 input 直接改。
               这里用 wx:if 而不是 hidden：自定义组件对 hidden 不生效，节点仍占位、
               占位文案还露在外面。摘掉 phone-get 是安全的——切换只发生在授权回调
               已经处理完之后（成功写值、或失败转手输），不会把还等着回调的组件销毁。
               也不能反过来做成「input 上盖一层」：input 是原生组件，盖不住，见 phone-get -->
          <input
            wx:if="{{profile.phone || phoneManual}}"
            class="input"
            type="number"
            value="{{profile.phone}}"
            placeholder="11 位手机号"
            placeholder-class="ph"
            maxlength="11"
            focus="{{phoneFocus}}"
            bindinput="onPhoneInput"
            bindblur="onPhoneBlur"
          />
          <phone-get
            wx:else
            placeholder="11 位手机号"
            bind:got="onWxPhone"
            bind:manual="onPhoneManual"
          />
        </view>

        <view class="row">
          <text class="label">电子邮箱</text>
          <input
            class="input"
            value="{{profile.email}}"
            placeholder="选填"
            placeholder-class="ph"
            maxlength="60"
            bindinput="onEmailInput"
          />
        </view>

        <picker
          class="row-picker"
          mode="date"
          start="{{birthdayStart}}"
          end="{{today}}"
          value="{{profile.birthday}}"
          bindchange="onBirthdayChange"
        >
          <view class="picker-row">
            <text class="label">生日</text>
            <text class="value {{profile.birthday ? '' : 'value-empty'}}">{{profile.birthday ? profile.birthday : '请选择'}}</text>
            <text class="chevron">›</text>
          </view>
        </picker>

        <picker
          class="row-picker"
          range="{{genders}}"
          value="{{profile.genderIndex}}"
          bindchange="onGenderChange"
        >
          <view class="picker-row">
            <text class="label">性别</text>
            <text class="value {{profile.genderIndex < 0 ? 'value-empty' : ''}}">{{profile.genderIndex < 0 ? '请选择' : genders[profile.genderIndex]}}</text>
            <text class="chevron">›</text>
          </view>
        </picker>

        <picker
          class="row-picker"
          mode="region"
          value="{{profile.region}}"
          bindchange="onRegionChange"
        >
          <view class="picker-row">
            <text class="label">居住城市</text>
            <text class="value {{regionText ? '' : 'value-empty'}}">{{regionText ? regionText : '请选择'}}</text>
            <text class="chevron">›</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- ========== 我的顾问 ========== -->
  <view class="sec">
    <view
      class="sec-head"
      hover-class="sec-head-hover"
      hover-stay-time="120"
      data-k="advisor"
      bindtap="onToggleSection"
    >
      <text class="sec-title">我的顾问</text>
      <text class="sec-mark {{open.advisor ? 'sec-mark-on' : ''}}">›</text>
    </view>

    <view class="sec-body" wx:if="{{open.advisor}}">
      <view class="card card-advisor">
        <text class="adv-hi">Hi{{profile.memberName ? '，' + profile.memberName : ''}}</text>

        <!-- 顾问姓名没定时整句略过名字，不留「（姓名待定）」这种占位给客户看 -->
        <text class="adv-line">我是{{advisor.name ? advisor.name + '，是您' : '您'}}在安东尼之家的专属服务顾问。我很荣幸能够为您提供服务！</text>
        <text class="adv-line">您可以通过以下的方式找到我，</text>

        <!-- 号码点一下直接拨 -->
        <view
          class="adv-phone"
          hover-class="adv-phone-hover"
          hover-stay-time="120"
          bindtap="onCallAdvisor"
        >
          <text class="adv-phone-label">手机</text>
          <text class="adv-phone-num">{{advisor.phone}}</text>
          <text class="adv-phone-act">拨号</text>
        </view>

        <text class="adv-line">或通过长按二维码进行识别，添加我的微信！</text>

        <image
          wx:if="{{advisor.qrcode}}"
          class="adv-qr"
          src="{{advisor.qrcode}}"
          mode="widthFix"
          show-menu-by-longpress
        />
        <view class="adv-qr-slot" wx:else>
          <text class="adv-qr-slot-text">企业微信二维码待放入</text>
        </view>

        <text class="adv-line">当您在安东尼之家遇到任何问题，我都将乐于第一时间为您服务！</text>
      </view>
    </view>
  </view>

  <!-- ========== 我的服务 ========== -->
  <view class="sec">
    <view
      class="sec-head"
      hover-class="sec-head-hover"
      hover-stay-time="120"
      data-k="service"
      bindtap="onToggleSection"
    >
      <text class="sec-title">我的服务</text>
      <text class="sec-mark {{open.service ? 'sec-mark-on' : ''}}">›</text>
    </view>

    <view class="sec-body" wx:if="{{open.service}}">
      <view class="card">
        <view class="empty">
          <text class="empty-text">还没有服务记录</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 我的预约 ========== -->
  <view class="sec">
    <view
      class="sec-head"
      hover-class="sec-head-hover"
      hover-stay-time="120"
      data-k="appt"
      bindtap="onToggleSection"
    >
      <text class="sec-title">我的预约</text>
      <text class="sec-mark {{open.appt ? 'sec-mark-on' : ''}}">›</text>
    </view>

    <view class="sec-body" wx:if="{{open.appt}}">
      <view class="card">
        <block wx:if="{{records.length}}">
          <view class="rec" wx:for="{{records}}" wx:key="createdAt">
            <view class="rec-main">
              <text class="rec-date">{{item.dateText}}</text>
              <text class="rec-meta">{{item.purpose}} · {{item.partySize}} 人</text>
            </view>
          </view>
        </block>

        <view class="empty" wx:else>
          <text class="empty-text">还没有预约记录</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 安玺·集 ==========
       订单和地址是两个独立页面，不做成可展开的分区：它们内容多、有自己的
       分页和表单，塞进这一页会让「我的」变成一个什么都有的长页面 -->
  <view class="sec">
    <view class="link" bindtap="onOrders" hover-class="link-hover" hover-stay-time="120">
      <text class="link-title">我的订单</text>
      <text class="link-mark">›</text>
    </view>
    <view class="link" bindtap="onAddresses" hover-class="link-hover" hover-stay-time="120">
      <text class="link-title">收货地址</text>
      <text class="link-mark">›</text>
    </view>
  </view>

  <view class="foot">
    <text class="foot-brand">{{brand.wordmark}}</text>
    <text class="foot-city">{{brand.city}}</text>
  </view>

</view>
