# 复制成 .env 后填真实值。.env 不进版本库。
# 密码里有特殊字符时要 percent-encode，例如 ! -> %21
DATABASE_URL=postgres://用户名:密码@主机:端口/库名

# 安家立业的库。**无后缀的那一项属于安东尼之家**，是历史原因——先有它，
# 后接的小程序一律加小程序名后缀。见 docs/adr/0001-单进程多库承载小程序矩阵.md。
#
# 一个进程装整个矩阵，但一个小程序一个库：openid 是「本小程序内」的标识，
# 两个小程序的用户不是同一批人，混在一张表里 openid 就不再唯一。
#
# 不配这一项：服务照常启动，只是 /api/anjia/ 那组接口不注册，启动日志里有 warning。
# 这样这份代码推到还没建库的机器上时，不会把安东尼之家一起带下线。
DATABASE_URL_ANJIA=postgres://用户名:密码@主机:端口/anjia_dev

# 微信小程序。在小程序后台「开发管理 - 开发设置」里拿，
# secret 只在生成时看得到一次，丢了只能重置
WX_APPID=
WX_SECRET=

# 安家立业的小程序，另一个 appid（wx89c6660cf345877f）。
# ⚠️ 绝不能和上面填成同一套：appid 拿错换来的是另一个小程序的 openid 体系，
# 落库之后是认错人，而微信只回一句 40029，看不出是配串了。
WX_APPID_ANJIA=
WX_SECRET_ANJIA=

# 日志级别，默认 INFO，开发环境设 DEBUG。取值不合法会直接启动失败
LOG_LEVEL=DEBUG

# 雪花 ID 的机器号，0-1023，每个实例必须不同，否则会发出重复的用户 id。
# 留空则按容器主机名推导（见 app/snowflake.py）——云托管这类平台自动扩缩容，
# 没法给每个实例配不同的值，所以容器部署建议不要填这一项
#
# 本机固定 0。服务器上的两个容器分别是 0（生产 api）和 1（api-dev），
# 见 deploy/.env.example。三者连的是三个不同的库，撞号不会冲突主键，
# 但错开是免费的，将来合并数据或改指同一个库时就靠它
WORKER_ID=0

# 腾讯云 COS。密钥在控制台「访问管理 - API 密钥管理」拿
# 上线务必换成只有该桶读写权限的子账号密钥，不要用主账号密钥
#
# 桶按环境分开，不要混用——开发时清桶、造数据不该碰到线上：
#   开发  antony-casa-dev-1327365963
#   生产  antonycasa-pro-1327365963（配在服务器上的 .env 里，不是这份）
# 只有品牌实拍图（static/home、static/service）是例外，它只有一份、放在生产桶，
# 客户端写死地址直读，由 scripts/upload_static.py 推上去，跟这一项无关。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=antony-casa-dev-1327365963
COS_REGION=ap-shanghai

# 管理后台的超级管理员。这一个账号定义在配置里、不入库：
# 它是后台唯一的初始钥匙，其余管理员账号由它登录后在「账号管理」页创建。
# 两项缺一服务直接启动失败——不给默认值，否则某次部署忘了配就会让后台裸奔。
#
# 改密码 = 改这里 + 重启服务。超管在系统内改不了自己的密码。
#
# ⚠️ 用户名同样要换，别用 root / admin / antony 这类一猜就中的名字。
# 登录失败计数锁的是**用户名**：对着一个已知的用户名连发 5 次错密码就能把它锁
# 15 分钟，每 15 分钟发一轮即可维持永久锁定。而超管是唯一能建号、重置密码、
# 启停账号的角色，锁住它等于冻结全部账号运维，只能 ssh 上去删表行才解得开
# （SQL 见 deploy/README.md）。用户名不容易猜到，这条路才走不通。
#
# 密码只能用 ASCII 字符：它要在部署环境里手敲/粘贴，全角符号和不可见字符
# 很容易在终端和编辑器之间跑丢，服务启动时会直接拒绝非 ASCII 的值。
ADMIN_SUPER_USERNAME=请改成一个不容易猜的用户名
ADMIN_SUPER_PASSWORD=

# 微信支付 APIv3。**只支持「微信支付公钥」模式**，不支持平台证书——
# 官方对新商户的指引就是直接用公钥（平台证书有效期 5 年、要主动轮换，
# 还得自己处理下载与缓存），安玺·集是全新接入，落在「无需切换」那一档。
#
# 这几项缺任何一个，服务照常启动，只是下单时返回「支付暂未开通」，
# 且超时关单的扫描任务不会启动（启动日志里会写明缺哪几项）。
# 这样不涉及交易的功能在没有支付配置的机器上仍然可以开发和跑测试。
#
# appid 不在这里配：支付用的就是上面的 WX_APPID，小程序只有一个。
WXPAY_MCHID=
WXPAY_APIV3_KEY=
WXPAY_CERT_SERIAL=

# 商户 API 私钥与微信支付公钥。两种给法，内联优先：
#   内联——把 PEM 的换行写成字面量的 \n（两端可以带引号），一行塞进来
#   路径——密钥文件单独放，这里只写路径。服务器上更适合这种：文件权限管得住，
#         而 .env 会被 docker compose 整个读进环境变量
WXPAY_PRIVATE_KEY=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_PUBLIC_KEY=
WXPAY_PUBLIC_KEY_PATH=
# 公钥 ID。与公钥必须成对，只配一个会在初始化时报错，不静默降级
WXPAY_PUBLIC_KEY_ID=

# 发货通知的订阅消息模板 ID。在小程序后台「功能 - 订阅消息」里添加模板后拿到。
# 不配就不发通知，其余功能不受影响。
#
# ⚠️ 模板的**字段键名**（thing1 / character_string2 这种）由微信在添加模板时分配，
# 不同人添加同一个模板拿到的编号可能不同。app/wxnotice.py 的 _FIELDS 必须按你
# 实际那个模板改，对不上微信会返回 47003，日志里看得到。
WX_SHIP_TEMPLATE_ID=

# 订单号前缀。两位大写字母，**生产 AX、开发 AD**，两个环境必须不同。
#
# 微信支付没有沙箱：开发环境与生产环境用的是同一个商户号、同一套密钥。而订单号的
# 序号取自 shop_order_seq 表，两个环境是两个独立的库，各自从 1 开始发号——不分
# 前缀的话，同一天必然发出同名的 out_trade_no，而它在**商户维度**必须唯一。
# 撞号之后：超时关单会去关**对方环境里客户正在支付的那一单**，每日退款对账会把
# 对方的退款同步到自己同号的订单上。两件事都是自动发生的，没有人工环节能拦。
#
# 不配默认 AX（生产）。改这一项只影响**新单**，已有订单的号不会变。
# 见 app/order_no.py 与 migrations/012_payment_hardening.sql
ORDER_NO_PREFIX=AX

# 支付结果回调。必须公网可达的 https，且**按环境分**：
#   本地开发   微信回调不到 127.0.0.1，本地只能靠主动查单，这一项可以填开发环境的
#   开发环境   https://dev.antonycasa.weelume.com/api/shop/pay/notify
#   生产       https://antonycasa.weelume.com/api/shop/pay/notify
WXPAY_NOTIFY_URL=

# ---------------------------------------------------------------------------
# 下面两项**本地服务不读**，只有 deploy/deploy.sh 在**首次部署**、远端还没有 .env 时
# 会抄进远端那份，作为服务器上 api-dev 容器（dev.antonycasa.weelume.com，
# 小程序预览/体验版打的那个环境）的超管账号。
# 远端 .env 已经存在的话，deploy.sh 保留不动，改这里没有任何效果——
# 那时要直接改服务器上的 .env，见 deploy/README.md。
#
# 别和上面生产那一套填成一样的：dev 域名同样公网可达，共用凭据等于把生产后台的
# 口令多暴露一处。
DEV_ADMIN_SUPER_USERNAME=
DEV_ADMIN_SUPER_PASSWORD=
