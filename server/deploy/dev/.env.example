# 远端 ~/workspace/antony-casa-dev/.env 的模板 —— **开发环境**。
#
# 与生产那份（deploy/.env.example → ~/workspace/antony-casa/.env）是两个独立文件。
# 分开是为了改开发环境的配置时，不用打开那个装着生产 COS 密钥、生产超管密码、
# 支付私钥的文件。
#
# 这里的 key 名和本地 server/.env 一样，没有 DEV_ 前缀——环境靠目录区分，
# 不靠变量名。

# ---- 库 ----
# 连的是生产项目里那个 postgres 容器的**另一个库**。用户名密码与生产同一套
# （同一个实例），只有库名不同。密码只用字母数字：DATABASE_URL 是拼出来的，
# 出现 @ : / ? # 等 URI 保留字符会把连接串拼坏
POSTGRES_USER=antony
POSTGRES_PASSWORD=
POSTGRES_DB=antony_casa_dev

# ---- 镜像 ----
# 与生产的 latest 分开。deploy.sh --dev-only 推的就是这个 tag
API_TAG=dev

# ---- 微信小程序 ----
# 与生产同一套：小程序只有一个 appid
WX_APPID=
WX_SECRET=

# ---- 安家立业（第二个小程序）----
# 一库一个小程序（docs/adr/0001）。三项留空 = /api/anjia/ 那组接口不注册，
# 其余照常，安东尼之家不受影响。
#
# ⚠️ **先建库并跑过 schema.anjia.sql，再填这一项**：库不存在时容器在启动期
# 开池就会失败，api-dev 会无限重启。建库步骤见 deploy/README.md「安家立业的库」。
# 主机名用 antony-casa-postgres（那个 postgres 容器在生产那个 compose 项目里）：
# DATABASE_URL_ANJIA=postgres://antony:密码@antony-casa-postgres:5432/anjia_dev
DATABASE_URL_ANJIA=
# 安家立业自己的 appid 与 secret，与生产同一套。
# ⚠️ 绝不能和上面 WX_APPID 填成同一套，那是另一个小程序的 openid 体系
WX_APPID_ANJIA=
WX_SECRET_ANJIA=

# ---- 应用 ----
# 开发环境用 DEBUG，预览出问题时靠它定位
LOG_LEVEL=DEBUG
# 与生产 api 的 0 错开
WORKER_ID=1

# ---- 腾讯云 COS ----
# 开发桶。开发环境上传的头像、商品图落在这里，不进生产桶。
# 密钥与生产同一把（账号级），桶不同
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=antony-casa-dev-1327365963
COS_REGION=ap-shanghai

# ---- 后台超管 ----
# **不要和生产填成同一套**：dev 域名同样公网可达，而且它也出后台管理页面
# （https://dev.admin.antonycasa.weelume.com/），共用凭据等于把生产后台的
# 口令多暴露一处。两项缺一容器起不来
ADMIN_SUPER_USERNAME=
ADMIN_SUPER_PASSWORD=

# ---- 微信支付 ----
# ⚠️ 微信支付**没有沙箱**，商户号与密钥和生产是同一套，在这里付的也是真钱
# （可以退）。联调建议先把某个商品改成 0.01 元，测完退款。
#
# 按环境分开的有**两项**，少配任何一项都会串到生产上去：
#   WXPAY_NOTIFY_URL   不分的话，开发环境的支付结果会被推到生产容器上
#   ORDER_NO_PREFIX    不分的话，两边会发出同名的商户订单号，见下面那一节
#
# 只支持「微信支付公钥」模式，不支持平台证书，理由见 app/wxpay.py。
#
# 七项要配齐才生效（缺项时下单返回「支付暂未开通」，启动日志会逐项列出缺哪个）。
# 注意商户证书序列号在公钥模式下**照样必填**：它和公钥是两个方向的东西——
# 序列号进 Authorization 头，让微信知道用哪把公钥验**我们**的签名；
# 微信支付公钥则是我们验**微信**的签名。
WXPAY_MCHID=
WXPAY_APIV3_KEY=
WXPAY_CERT_SERIAL=
WXPAY_PUBLIC_KEY_ID=
WXPAY_NOTIFY_URL=https://dev.antonycasa.weelume.com/api/shop/pay/notify

# 发货通知的订阅消息模板 ID。留空 = 不发通知，其余功能不受影响。
# 从小程序后台「功能 → 订阅消息 → 公共模板库」添加模板后拿到。
# 模板与小程序绑定、和环境无关，所以这里填的和生产是同一个值。
# 字段键名的坑见 deploy/.env.example 的同名小节
WX_SHIP_TEMPLATE_ID=

# 订单号前缀。两位大写字母，**这里必须是 AD**（生产是 AX）。
#
# 商户号两边共用，可订单号的序号取自各自库里的 shop_order_seq——生产库和
# antony_casa_dev 各自从 1 开始发号。不分前缀的话，同一天两边必然发出同名的
# out_trade_no，而它在**商户维度**必须唯一，撞上之后：
#
#   * 这边的超时关单扫描调 close_order(单号)，关掉的是**生产上同号的那一单**，
#     也就是一个真实客户正在支付的订单
#   * 这边退一笔测试单，第二天生产的退款对账会读到商户级账单里的这条记录，
#     把生产上同号的订单自动置成「已退款」
#   * 拿一个已被生产占用的号下单，微信要么报单号重复，要么返回绑定到生产那笔
#     订单的 prepay
#
# 三件事都是自动发生的，没有任何人工环节能拦住。见 app/order_no.py
ORDER_NO_PREFIX=AD

# 两把 PEM 走**文件**，不写进这里。
#
# 把 apiclient_key.pem 与 pub_key.pem 放进本目录的 secrets/ 下：
#   mkdir -p secrets && chmod 755 secrets
#   vi secrets/apiclient_key.pem      # 整份 PEM 原样粘进去，多行没关系
#   vi secrets/pub_key.pem
#   chmod 644 secrets/*.pem           # 644 不是笔误，见 docker-compose.yml 的注释
#
# 下面填的是**容器内**的路径，不是宿主路径——secrets/ 挂在容器的
# /run/secrets/wxpay 下。填成宿主路径的话容器里找不到文件，
# 而报错要到第一次下单才出现。
#
# 为什么不内联：PEM 是多行的，塞进 .env 要把换行写成字面量 \n，粘错一次
# 整个 .env 就被 compose 判为语法错误，那个目录里所有 compose 命令一起失败。
# （内联的写法仍然支持，app/wxpay.py 里内联优先，本地开发用它更省事。）
WXPAY_PRIVATE_KEY_PATH=/run/secrets/wxpay/apiclient_key.pem
WXPAY_PUBLIC_KEY_PATH=/run/secrets/wxpay/pub_key.pem
