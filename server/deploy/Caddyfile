# 四个站点，两两对应——生产一组、开发一组：
#
#   antonycasa.weelume.com            官网（antony-web）      → api      → antony_casa
#   admin.antonycasa.weelume.com      后台管理（website）      → api      → antony_casa
#   dev.antonycasa.weelume.com        官网 + 小程序接口        → api-dev  → antony_casa_dev
#   dev.admin.antonycasa.weelume.com  后台管理（开发库）        → api-dev  → antony_casa_dev
#
# 两组共用同一个 caddy 和同一个 postgres 实例，其余全部分开：
# 后端容器、库、前端产物各一份。
#
# ⚠️ 两个后端容器在**不同的 compose 项目**里：
#   生产 api      ~/workspace/antony-casa/docker-compose.yml       项目 antony-casa
#   开发 api-dev  ~/workspace/antony-casa-dev/docker-compose.yml   项目 antony-casa-dev
# 所以下面反代到开发环境时用的是**容器名** antony-casa-api-dev 而不是服务名：
# 服务名别名依赖 compose 给外部网络也加别名的行为，容器名是 docker 自己保证的。
# 本文件仍然放在生产目录里——caddy 只有一个，它是两个环境共用的基础设施。
#
# 证书由 Caddy 分别自动申请并续期，落在 data/caddy/data/ 下。
# 前提：四个域名都解析到本机，且安全组放行 80（HTTP-01 校验走 80，不通就签不下来）。
# ⚠️ 加新域名之前必须先把 DNS 解析建好：域名写在这里但解析不过来的话，
# Caddy 会一直重试签发、刷满日志，还会撞上 Let's Encrypt 每周 5 次的失败上限。

# 三个站点都要的加固。与反代目标无关，所以单独成片——dev 站点的上游是另一个容器
(hardening) {
	encode zstd gzip

	# 上线几分钟就有扫描器来试 /.env、/.git/HEAD、/.ssh/id_rsa。下面的 SPA 回落
	# 会把它们统统变成 index.html 返回 200——内容没泄漏，但 200 会让扫描器判定
	# 「存在」，也把访问日志刷满。点开头的路径本来就不是前端路由，直接 404。
	# 必须排除 /.well-known/：Let's Encrypt 的 HTTP-01 校验走这个前缀，
	# 拦掉的话证书续期会失败（首签能过是因为签发时这条规则还没生效，很难查）
	@dotfiles {
		path_regexp ^/\.
		not path /.well-known/*
	}
	respond @dotfiles 404
}

# 静态产物的托管与缓存。四个站点共用一份，只有 root 各自不同。
#
# 缓存按两类分，不能一刀切：
#   /assets/*   文件名带内容 hash（vite 出的），内容永不变 → 存一年
#   其余        index.html 和所有 SPA 深链接回落 → no-cache，每次回源校验
#
# index.html 被缓存住的后果不是「看到旧页面」这么直白：它指向的
# /assets/index-<旧hash>.js 已经随发版删掉了，而下面的 SPA 回落会把这个 404
# 变成「200 + index.html」——浏览器请求 .js 收到一份 HTML，控制台里只有一句
# MIME 类型错误，页面就静悄悄停在上一个版本，看着像压根没发布。
# 2026-08-25 发后台时踩过一次，访问日志里是：
#   GET /assets/index-C6kN7nxC.js -> 200 text/html (484 字节)
#
# 同一个理由，/assets/ 下找不到的文件直接 404，不让它走回落：
# 一个诚实的 404 比一份伪装成 JS 的 HTML 好查得多。回落只对页面路径有意义。
#
# 必须整段包在 route 里：route 严格按书写顺序执行，散着写的话 Caddy 会按默认
# 指令顺序重排，respond 排到 file_server 后面就永远轮不到它。
(spa) {
	route {
		# 先把「产物不存在」挡掉，再谈缓存。顺序反过来的话这个 404 会带上
		# 下面那条一年期的 immutable，浏览器就把「这个文件不存在」缓存一年——
		# 发版时若有人正好在新 index.html 和新产物之间的那一瞬间刷新，
		# 他那台机器就再也拉不到那个文件了。
		@asset_missing {
			path /assets/*
			not file
		}
		respond @asset_missing 404

		@asset path /assets/*
		@page not path /assets/*
		header @asset Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}

# 官网和后台重复的部分，改一处两边同时生效
(shared) {
	import hardening

	# 接口。两个站点都要用：官网提交预约和服务申请，后台读列表。
	#
	# ⚠️ 上游必须写**容器名** antony-casa-api，不能写服务名 api。
	# 开发项目里的服务也叫 api（见 deploy/dev/docker-compose.yml），而它接的是
	# 生产这张 antony-casa_default 网——compose 按服务名给每个容器加网络别名，
	# 于是这张网上 `api` 同时解析到生产和开发两个容器，docker 内嵌 DNS 轮询返回：
	#
	#   nslookup api  ->  172.18.0.3 (antony-casa-api)  +  172.18.0.5 (antony-casa-api-dev)
	#
	# 后果是官网和后台的 /api/* 有一半打进开发后端和开发库：后台表现为随机 401
	# 被踢回登录页（token 在开发库里不存在），官网表现为预约和服务申请随机写进
	# 开发库。容器名由 docker 自己保证唯一，不受这个别名机制影响
	handle /api/* {
		reverse_proxy antony-casa-api:3000
	}
}

# ---------------------------------------------------------------- 官网
antonycasa.weelume.com {
	# 用 route 而不是散着写 handle：route 严格按书写顺序匹配，
	# 而 handle 之间是按 matcher 特异性重排的，正则 matcher 排在哪不好预期
	route {
		import shared

		# 存活检查。同时反映数据库连得上没有——连接池打开后 /health 才可用。
		# 同样必须用容器名，理由见上面 (shared) 里那段：写服务名的话这条探针
		# 有一半概率探的是开发后端，生产挂了也可能一直返回 200
		handle /health {
			reverse_proxy antony-casa-api:3000
		}

		# 其余路径出官网 SPA。react-router 用的是 history 路由，深链接直接刷新时
		# 磁盘上并没有对应文件，必须回落到 index.html，否则一刷新就 404
		handle {
			root * /srv/site
			import spa
		}
	}

	log {
		output stdout
		format console
	}
}

# ------------------------------------------------------------ 后台管理
admin.antonycasa.weelume.com {
	route {
		import shared

		handle {
			root * /srv/admin
			import spa
		}
	}

	log {
		output stdout
		format console
	}
}

# ---------------------------------------------------------------- 开发环境
# 与上面两个生产站点一一对应，只是上游换成 api-dev、库换成 antony_casa_dev：
#
#   dev.antonycasa.weelume.com        官网 + 接口   ← 小程序预览打这个
#   dev.admin.antonycasa.weelume.com  后台管理      ← 给开发库配数据用
#
# 静态产物**自己一份**（/srv/dev-site、/srv/dev-admin），不与生产共用。
# 共用的话「更新开发环境的后台」就等于「换掉生产的后台」，而开发环境要能验
# 还没发布的前端改动，那正是它存在的意义之一。
# 两份 dist 在 ~/workspace/antony-casa-dev/ 下，由 deploy.sh --dev-only 同步。
#
# 前端代码本身不需要为环境分叉：两份产物都用相对路径请求 /api/*，
# 同一份 dist 在哪个域名下打开，打的就是那个域名背后的后端。

# 小程序的预览 / 真机调试 / 体验版打这里（antony-casa/utils/config.js 的 DEV_BASE）。
# 手机连不到开发机的 127.0.0.1，所以这三种场景必须有一个公网可达的 https 地址，
# 而微信只认备案域名——weelume.com 的主体备案覆盖子域名，所以挂在这里。
dev.antonycasa.weelume.com {
	route {
		import hardening

		handle /api/* {
			reverse_proxy antony-casa-api-dev:3000
		}

		# 存活检查。走的是 api-dev + 开发库，与生产那条链路互不说明问题
		handle /health {
			reverse_proxy antony-casa-api-dev:3000
		}

		handle {
			root * /srv/dev-site
			import spa
		}
	}

	log {
		output stdout
		format console
	}
}

# 开发库的后台。开发环境的数据（上架商品、配首页图）只能从这里维护——
# 那个库在 compose 内网，本地跑的后台连不到它。
# 登录用 ~/workspace/antony-casa-dev/.env 的 ADMIN_SUPER_*，和生产后台是两套账号。
dev.admin.antonycasa.weelume.com {
	route {
		import hardening

		handle /api/* {
			reverse_proxy antony-casa-api-dev:3000
		}

		handle {
			root * /srv/dev-admin
			import spa
		}
	}

	log {
		output stdout
		format console
	}
}

# 说明：FastAPI 自带的 /docs 和 /openapi.json 没有代理出去。
# /api/admin/* 现在已经要求登录，但公开接口清单本身仍然是免费的信息，
# 没必要为了方便调试多留一个暴露面。
# 临时自查可以在服务器上打内网地址：
#   docker exec antony-casa-caddy wget -qO- http://antony-casa-api:3000/openapi.json
# （同样用容器名——服务名 api 在这张网上会轮询到开发容器，见 (shared) 里那段）
