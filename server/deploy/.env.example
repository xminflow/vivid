# 远端 /home/deploy/workspace/antony-casa/.env 的模板。
# 这个文件被 docker compose 自动读取，既用于 ${} 插值，也是唯一的密钥来源。
# 真实的 .env 只存在于服务器上，不进版本库，也不由 deploy.sh 覆盖
# （首次部署时脚本会用这个模板生成一份，之后每次部署都原样保留）。

# ---- 自建 Postgres ----
# 密码只用字母和数字：compose 里 DATABASE_URL 是字符串拼出来的，
# 出现 @ : / ? # 等 URI 保留字符会把连接串拼坏
POSTGRES_USER=antony
POSTGRES_PASSWORD=
POSTGRES_DB=antony_casa

# ---- 微信小程序 ----
# 「开发管理 - 开发设置」里拿。secret 只在生成时显示一次
WX_APPID=
WX_SECRET=

# ---- 安家立业（第二个小程序）----
# 一库一个小程序（docs/adr/0001），所以它有自己的库和自己的 appid。
# 三项**默认全部留空**：留空时 /api/anjia/ 与 /api/admin/anjia/ 整组接口不注册，
# 服务照常起，安东尼之家不受任何影响（启动日志里会有一行 warning）。
# 代价是后台侧「安家立业」那两页会 404——那说明这三项还没配。
#
# ⚠️ 顺序不能反：**先建库并跑过 schema.anjia.sql，再填 DATABASE_URL_ANJIA**。
# 库不存在时容器在启动期开池就会失败，而 api 容器是官网、小程序、后台共用的，
# 那等于把安东尼之家一起带下线。建库步骤见 deploy/README.md「安家立业的库」。
#
# 主机名填 postgres（compose 网络里的服务名），不是 localhost：
# DATABASE_URL_ANJIA=postgres://antony:密码@postgres:5432/anjia
DATABASE_URL_ANJIA=
# 安家立业自己的 appid（wx89c6660cf345877f）与配套 secret。
# ⚠️ 绝不能和上面 WX_APPID 填成同一套：appid 拿错换来的是另一个小程序的 openid
# 体系，落库之后是认错人，而微信只回一句 40029，看不出是配串了
WX_APPID_ANJIA=
WX_SECRET_ANJIA=

# ---- 应用 ----
# 生产用 INFO；排查问题时临时改成 DEBUG 并 docker compose up -d api 重启
LOG_LEVEL=INFO
# 雪花 ID 机器号。单实例固定 0；多实例部署必须逐实例不同，否则会发出重复 id
WORKER_ID=0

# ---- 腾讯云 COS ----
# 生产桶，别填成开发桶 antony-casa-dev-1327365963：那样开发时清桶会清掉线上的
# 用户头像和后台配的首页图，而且从接口返回值上看不出来用的是哪个桶
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=antonycasa-pro-1327365963
COS_REGION=ap-shanghai

# ---- 微信支付 ----
# 只支持「微信支付公钥」模式，不支持平台证书（官方对新商户的指引就是直接用公钥）。
# 七项配齐才生效；缺项时下单返回「支付暂未开通」、超时关单扫描不启动，
# 启动日志会逐项列出缺哪个。
#
# 商户号与密钥和开发环境是**同一套**——微信支付没有沙箱，只有一个真实商户号。
# 只有回调地址按环境分，否则开发环境的支付结果会被推到这个生产容器上来。
WXPAY_MCHID=
WXPAY_APIV3_KEY=
WXPAY_CERT_SERIAL=
WXPAY_PUBLIC_KEY_ID=
WXPAY_NOTIFY_URL=https://antonycasa.weelume.com/api/shop/pay/notify

# 发货通知的订阅消息模板 ID。留空 = 不发通知，其余功能不受影响。
#
# 在小程序后台「功能 → 订阅消息 → 公共模板库」里选一个发货通知类模板添加后拿到。
# ⚠️ 模板的**字段键名**（thing2 / character_string4 这种编号）由微信在添加模板时
# 分配，不同人添加同一个模板拿到的编号可能不同。app/wxnotice.py 的 _FIELDS 必须
# 按你实际那个模板改，对不上微信返回 47003，日志里看得到。
WX_SHIP_TEMPLATE_ID=

# 订单号前缀。两位大写字母，**生产 AX、开发 AD，两边必须不同**。
#
# 上面那段说了商户号两个环境共用。订单号的序号却取自各自库里的 shop_order_seq，
# 都从 1 开始——不分前缀就会发出同名的 out_trade_no（它在商户维度必须唯一）。
# 撞号之后开发环境的超时关单会去关**这个生产环境里客户正在支付的那一单**，
# 每日退款对账会把开发环境退的测试单同步成生产订单的已退款。全自动，无人能拦。
ORDER_NO_PREFIX=AX

# 两把 PEM 放在本目录的 secrets/ 下（apiclient_key.pem / pub_key.pem），
# 下面填的是**容器内**路径。做法与理由见 deploy/dev/.env.example 的同名小节
WXPAY_PRIVATE_KEY_PATH=/run/secrets/wxpay/apiclient_key.pem
WXPAY_PUBLIC_KEY_PATH=/run/secrets/wxpay/pub_key.pem

# ================================================================ 开发环境
# 以下是 api-dev 容器（dev.antonycasa.weelume.com）的配置，供小程序的
# 预览 / 真机调试 / 体验版使用。上面那些是生产 api 的，两套不要混。
#
# WX_APPID / WX_SECRET / COS_SECRET_ID / COS_SECRET_KEY / COS_REGION 两边共用，
# 不在这里重复：小程序只有一个 appid，COS 密钥现在也还是账号级的同一把。

# 开发环境的库名。**和生产在同一个 postgres 容器里**，只是另一个库，
# 用的也是上面那套 POSTGRES_USER / POSTGRES_PASSWORD（连接串在 compose 里拼）。
# 这个库不是 postgres 镜像自动建的（POSTGRES_DB 只建一个），
# 要手动 CREATE DATABASE + 跑一遍 schema.sql，见 README「开发环境」
DEV_POSTGRES_DB=antony_casa_dev

# 开发环境用的镜像 tag，与生产的 latest 分开。
# 分开是为了 `deploy.sh --dev-only` 只换开发容器：常规部署会把本地构建的镜像
# 推成 latest 并替换 api，而本地分支上常有还没发布的代码
DEV_API_TAG=dev

# 开发环境的日志级别与雪花 ID 机器号。
# DEV_WORKER_ID 与生产的 0 错开：现在两边是不同的库，撞号不会冲突主键，
# 但将来若合并数据、或让 api-dev 指向别的库，同号就会发出重复的雪花 id
DEV_LOG_LEVEL=DEBUG
DEV_WORKER_ID=1

# 开发桶。开发环境上传的头像、商品图落在这里，不进生产桶。
# 与本地开发共用同一个桶——本地和服务器开发环境的库虽然是两个，但对象键随机、
# 互不覆盖，为此再开一个桶没有意义
DEV_COS_BUCKET=antony-casa-dev-1327365963

# 开发环境后台的超级管理员，**不要**和上面生产那一套填成一样的：
# dev 域名同样是公网可达的（而且它也出后台管理页面），共用凭据意味着
# 开发域名上的口令泄漏会波及生产后台。
# 两项缺一 api-dev 容器起不来（只影响 dev 域名，生产不受影响）
DEV_ADMIN_SUPER_USERNAME=
DEV_ADMIN_SUPER_PASSWORD=
