/* 安家立业设计令牌 —— 简约大气。
 *
 * 三条不可动摇的规则，改令牌前先读一遍：
 *
 * 1. 整页只有一个色相（暖），只有一个品牌色。品牌色分两种用法，别混：
 *    - 顺带出现的（认证角标、选中态下划线、极少数标签）：面积必须极小。
 *    - 主 CTA（primary 按钮，含通栏）：不受面积限制，但一屏最多一个。它是这一屏
 *      要你做的那件事，改成墨黑就和普通文字控件分不清了。
 *    正文、图标、分隔线一律不用品牌色。
 * 2. 「大气」来自图片占比与标题字号，不来自留白。双列瀑布流里拉大边距只会
 *    把图挤小，反而显得局促——所以 --gutter 是刻意收紧的 24rpx。
 * 3. 全局不用 box-shadow，卡片不描边。边界靠 --bg 与 --surface 的明度差。
 *    二十张卡片各带一圈灰边，整页会糊。
 *
 * ⚠️ 不要照搬 antony-casa/styles/tokens.wxss。那套黑白无衬线 + 意大利语命名
 * 是安东尼之家的品牌语言；两个小程序面对的是完全不同的人，长成一个样是错的。
 */
page {
  /* ── 色 ────────────────────────────────────────────────────────────────
   * 文字色只有两档。antony-casa 有第三档浅灰（--grigio-chiaro），在这套暖底
   * 上只有 2.5:1，过不了 WCAG AA(4.5:1)。一档不能拿来写字的颜色，就不该以
   * 文字色的名义存在——要更弱的层级，用字号和字重去拉，不要再降对比度。
   */
  --bg: #F5F3F0;              /* 页底：暖中性，比卡片暗一档，白卡才浮得起来 */
  --surface: #FFFFFF;         /* 卡片、内容区 */
  --ink: #171614;             /* 标题与正文：暖墨黑，不用纯黑 —— 页底上 15.9:1 */
  --ink-weak: #6E6A63;        /* 全部副信息：作者名、时间、计数 —— 页底上 4.8:1 */
  --hairline: rgba(23, 22, 20, 0.08);        /* 分隔线：只用来分隔，不用来圈边 */
  --hairline-strong: rgba(23, 22, 20, 0.20); /* 描边：ghost 按钮这类要能看出「这里可以点」的边界。
                                                8% 在暖底上会消失，按钮退化成一段纯文字 */

  /* 品牌色：赭。陶土与原木的色温，与暖底同族 */
  --brand: #9A5B3D;           /* 白底上 5.3:1；白字压在它上面同样 5.3:1 */
  --brand-ink: #FFFFFF;       /* 压在品牌色上的字 */

  /* 压在图片上的字 */
  --on-photo: #FFFFFF;
  --on-photo-weak: rgba(255, 255, 255, 0.72);

  /* 骨架屏与图片占位。比页底再暗一档，不用灰——灰在暖底上会发青 */
  --placeholder: #EAE6E1;

  /* ── 字 ────────────────────────────────────────────────────────────────
   * 系统栈，不加载 web font：wx.loadFontFace 首屏必然闪一次，为了一个字体
   * 让每次冷启动都抖，不划算。
   */
  --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, "Microsoft YaHei", sans-serif;

  --fs-display: 52rpx;        /* 页面大标题。⚠️ 首页的大标题已按要求去掉，这一档目前
                                 全仓没有使用者——留着是给账号主页、会员中心这类
                                 需要撑气场的二级页，不是漏删。真到了那些页面还用
                                 不上，再删不迟 */
  --fs-title: 36rpx;          /* 区块标题、流切换 */
  --fs-body: 28rpx;           /* 正文 */
  --fs-card: 26rpx;           /* 瀑布流卡片标题 */
  --fs-meta: 22rpx;           /* 作者、时间、计数 */

  /* 字重只开三档。苹方 700 在 26rpx 以下会糊，一律不用 */
  --fw-normal: 400;
  --fw-medium: 500;
  --fw-bold: 600;

  --ls-display: -0.02em;      /* 大字收紧才紧凑 */
  --ls-meta: 0.02em;          /* 小字放开才透气 */

  /* ── 间距（8rpx 基） ──────────────────────────────────────────────── */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;
  --sp-6: 64rpx;

  --gutter: 24rpx;            /* 页面左右边距：收紧，把宽度让给图片 */
  --col-gap: 16rpx;           /* 瀑布流列间距 */

  /* ── 形状 ─────────────────────────────────────────────────────────── */
  --r-img: 12rpx;             /* 图片与卡片：几乎直角，只做一点柔化 */
  --r-btn: 8rpx;              /* 按钮：直角矩形，不用胶囊 */
  --r-tag: 4rpx;              /* 标签 */

  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.7;
}
