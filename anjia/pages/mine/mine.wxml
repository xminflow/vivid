<view class="page">
  <view class="title">我的</view>

  <view class="card" wx:if="{{user}}">
    <view class="row">
      <text class="label">用户 ID</text>
      <text class="value">{{user.id}}</text>
    </view>
    <view class="row">
      <text class="label">展示名</text>
      <text class="value">{{displayName}}</text>
    </view>
    <view class="row">
      <text class="label">微信昵称</text>
      <text class="value">{{user.nickname || '（未授权）'}}</text>
    </view>
    <view class="row">
      <text class="label">登录次数</text>
      <text class="value">{{user.loginCount}}</text>
    </view>
    <view class="row">
      <text class="label">注册于</text>
      <text class="value">{{user.createdAt}}</text>
    </view>
  </view>

  <view class="card entries" wx:if="{{user}}">
    <view class="row entry" bindtap="onMembership">
      <text class="label">会员中心</text>
      <text class="value {{user.isMember ? 'on' : ''}}">
        {{user.isMember ? '已开通' : '未开通'}}
      </text>
    </view>
    <view class="row entry" bindtap="onCertification">
      <text class="label">企业认证</text>
      <text class="value {{certLabel.on ? 'on' : ''}}">{{certLabel.text}}</text>
    </view>
  </view>

  <view class="hint" wx:if="{{!user && !error}}">正在登录…</view>

  <view class="error" wx:if="{{error}}">
    <text>{{error}}</text>
    <button class="retry" bindtap="onRetry" disabled="{{loading}}">重试</button>
  </view>
</view>
