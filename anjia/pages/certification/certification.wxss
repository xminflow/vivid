.page {
  padding: 80rpx 48rpx;
}

.hero {
  margin-bottom: 48rpx;
}

.headline {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.sub {
  margin-top: 16rpx;
  color: var(--text-weak);
  font-size: 26rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.row:last-child {
  border-bottom: none;
}

.label {
  color: var(--text-weak);
  flex: none;
}

.value {
  font-size: 26rpx;
  margin-left: 32rpx;
  text-align: right;
}

/* 驳回理由是这一页最该被看见的东西，给它自己的块而不是塞进卡片的一行 */
.rejected {
  background: var(--card);
  border-radius: var(--radius);
  padding: 32rpx;
  border-left: 6rpx solid #C0392B;
}

.rejected-title {
  font-weight: 600;
}

.rejected-reason {
  margin-top: 12rpx;
  color: var(--text);
  font-size: 26rpx;
}

.rejected-hint {
  margin-top: 12rpx;
  color: var(--text-weak);
  font-size: 24rpx;
}

.form {
  margin-top: 32rpx;
}

.field {
  background: var(--card);
  border-radius: var(--radius);
  padding: 20rpx 32rpx;
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  color: var(--text-weak);
  font-size: 24rpx;
}

.input {
  margin-top: 8rpx;
  font-size: 30rpx;
  height: 56rpx;
}

.submit {
  display: block;
  width: 100%;
  margin-top: 40rpx;
  padding: 28rpx 0;
  border-radius: var(--radius);
  background: var(--text);
  color: var(--card);
  font-size: 30rpx;
  text-align: center;
}

.submit[disabled] {
  opacity: 0.5;
}

.notice {
  margin-top: 24rpx;
  color: var(--text-weak);
  font-size: 24rpx;
  text-align: center;
}

.error {
  margin-top: 32rpx;
  color: #C0392B;
}

.retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 26rpx;
}
