<view class="page">
  <view class="hero">
    <view class="badge {{isMember ? 'badge-on' : ''}}">{{isMember ? '已开通' : '未开通'}}</view>
    <view class="headline">会员</view>
    <view class="sub">会员可以发起站内私信，在随安而遇与安选有品直接联系对方。</view>
  </view>

  <view class="card" wx:if="{{isMember}}">
    <view class="row">
      <text class="label">状态</text>
      <text class="value">已开通</text>
    </view>
    <view class="row" wx:if="{{expiresAt}}">
      <text class="label">有效期至</text>
      <text class="value">{{expiresAt}}</text>
    </view>
  </view>

  <block wx:else>
    <button class="join" bindtap="onJoin" disabled="{{joining}}">
      {{joining ? '开通中…' : '免费开通'}}
    </button>
    <view class="notice">当前免费开通，未来将会收费。</view>
  </block>

  <view class="error" wx:if="{{error}}">
    <text>{{error}}</text>
    <button class="retry" bindtap="onRetry" disabled="{{loading}}">重试</button>
  </view>
</view>
